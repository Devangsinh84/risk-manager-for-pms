# Edge Risk — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# -------------------------------------------------------
# Hugging Face Inference API
# Get your token at: https://huggingface.co/settings/tokens
# Required scope: "Make calls to the serverless Inference API"
# -------------------------------------------------------
HF_TOKEN=Your_HF_Token_here

# -------------------------------------------------------
# Database (optional override — defaults to local SQLite)
# For production, replace with a PostgreSQL URL:
# DATABASE_URL=postgresql://user:password@host:5432/edge_risk
# -------------------------------------------------------
DATABASE_URL=sqlite:///./enterprise_risk.db

# -------------------------------------------------------
# Backend server settings (optional)
# -------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# -------------------------------------------------------
# Frontend settings (optional — Vite reads VITE_ prefix)
# -------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
